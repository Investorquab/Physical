# --- Database ---
DATABASE_URL="postgresql://user:password@host:5432/physical"

# --- OpenAQ (real-world data source) ---
# Get a free key at https://explore.openaq.org/register
OPENAQ_API_KEY=""
# Comma-separated OpenAQ location ids (no spaces around commas)
OPENAQ_LOCATION_IDS="9589,148,625,1214508"
# Optional, defaults to pm25 if unset
OPENAQ_TARGET_PARAMETER="pm25"

# --- Ethereum Sepolia (source chain) ---
SEPOLIA_RPC_URL=""
SEPOLIA_SUBMITTER_PRIVATE_KEY=""
# Filled in after running: npx hardhat run scripts/deploy-source.ts --network sepolia
SOURCE_EVENT_REGISTRY_ADDRESS=""

# --- Creditcoin CC3 Testnet ---
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
CREDITCOIN_SUBMITTER_PRIVATE_KEY=""
# Filled in after running the deploy scripts in packages/contracts/scripts
PHYSICAL_ASC_ADDRESS=""
EVM_V1_DECODER_ADDRESS=""
PHYSICAL_SETTLEMENT_ADDRESS=""

# --- Attestcoin Protocol ---
PROOF_BUILDER_URL="https://proof-gen-api.cc3-testnet.creditcoin.network"

# --- API ---
API_PORT="4001"
# Set to your real frontend origin in production, never "*"
CORS_ORIGIN="http://localhost:3000"
